# TSFlow Backend Configuration
# Copy this file to .env and fill in your values

# Tailscale API credentials (required unless TAILSCALE_AUTH=wif)
TAILSCALE_API_KEY=your_tailscale_api_key_here
TAILSCALE_TAILNET=your_tailnet_here

# API workload identity. Leave unset to keep an API key or OAuth client.
# Set exactly one of the token file, the token, or the audience.
# TAILSCALE_AUTH=wif
# TAILSCALE_WIF_CLIENT_ID=your_federated_client_id
# TAILSCALE_WIF_ID_TOKEN_FILE=/var/run/tsflow/token
# TAILSCALE_WIF_AUDIENCE=api.tailscale.com/your_federated_client_id

# Flow log backend (optional: api or s3)
TSFLOW_FLOW_BACKEND=api

# S3/Garage flow log backend (required when TSFLOW_FLOW_BACKEND=s3)
# TSFLOW_S3_AUTH=static is the default. aws_default uses the AWS SDK chain
# (IRSA, Pod Identity, instance profile) and does not take static keys.
# TSFLOW_FLOW_BACKEND=gcs reads natively with Application Default Credentials.
# TSFLOW_S3_AUTH=static
TSFLOW_S3_BUCKET=tailscale-logs
TSFLOW_S3_PREFIX=network/
TSFLOW_S3_ENDPOINT=http://garage.garage.svc.cluster.local:3900
TSFLOW_S3_REGION=garage
TSFLOW_S3_ACCESS_KEY_ID=your_s3_access_key
TSFLOW_S3_SECRET_ACCESS_KEY=your_s3_secret_key
TSFLOW_S3_PATH_STYLE=true
TSFLOW_S3_LOOKBACK=15m
TSFLOW_S3_MAX_OBJECTS_PER_POLL=500

# Backend server configuration (optional)
PORT=8080
ENVIRONMENT=development

# Internal access control is off when these are unset.
# TSFLOW_ACCESS_CAPABILITY=example.com/cap/tsflow
# TSFLOW_ACCESS_MODE=header
# TSFLOW_ACCESS_GRANTS=identity
# TSFLOW_ACCESS_TRUSTED_PROXIES=127.0.0.1/32
# TSFLOW_ACCESS_GROUPS_HEADER=X-Tsflow-Groups
# TSFLOW_ACCESS_GROUP_GRANTS={"group:eng":{"tailnets":["default"]}}
# TSFLOW_ACCESS_AUTOSCOPE=off
# TSFLOW_LOG_LEVEL=debug
