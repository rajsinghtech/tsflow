# Tailscale Configuration
# Choose one authentication method:

# Method 1: API Key (Legacy)
# TAILSCALE_API_KEY=your-api-key-here

# Method 2: OAuth Client Credentials (Recommended)
TAILSCALE_OAUTH_CLIENT_ID=your-oauth-client-id
TAILSCALE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Optional: Specify tailnet (defaults to current)
# TAILSCALE_TAILNET=your-tailnet.ts.net

# Optional: API URL (defaults to https://api.tailscale.com)
# TAILSCALE_API_URL=https://api.tailscale.com

# Application Configuration
# Optional: Environment (defaults to "development", set to "production" for prod)
# ENVIRONMENT=production
PORT=8080

# SECURITY WARNING:
# Never commit actual credentials to git. These are examples only.
# Keep your .env file in .gitignore and rotate credentials if exposed.
